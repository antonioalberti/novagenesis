{
  "$id": "urn:ng039:ipc-inventory:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPEC-039 D2 IPC inventory",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "complete",
    "is_empty",
    "sysv_ids",
    "dev_shm_entries",
    "error",
    "proc_sysvipc_sha256",
    "proc_sysvipc_raw_b64"
  ],
  "properties": {
    "schema_version": {
      "const": "ng039-ipc-inventory/v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64
    },
    "phase": {
      "type": "string",
      "enum": [
        "pre",
        "post",
        "final"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "is_empty": {
      "type": "boolean"
    },
    "sysv_ids": {
      "type": "object",
      "required": [
        "shm",
        "sem",
        "msg"
      ],
      "properties": {
        "shm": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true,
          "maxItems": 4096
        },
        "sem": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true,
          "maxItems": 4096
        },
        "msg": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true,
          "maxItems": 4096
        }
      },
      "additionalProperties": false
    },
    "dev_shm_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "size",
          "owner",
          "mode",
          "ctime"
        ],
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "owner": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0
          },
          "ctime": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "proc_sysvipc_sha256": {
      "type": "object",
      "required": [
        "shm",
        "sem",
        "msg"
      ],
      "properties": {
        "shm": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sem": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "msg": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "proc_sysvipc_raw_b64": {
      "type": "object",
      "required": [
        "shm",
        "sem",
        "msg"
      ],
      "properties": {
        "shm": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "maxLength": 1398104
        },
        "sem": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "maxLength": 1398104
        },
        "msg": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "maxLength": 1398104
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
