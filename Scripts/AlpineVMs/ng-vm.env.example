# Copy this file to a local ignored path and source it before using AlpineVMs scripts.
# Never commit the local copy with real values.
export SOURCE_VM_IP="<source-ip>"
export REPO_VM_IP="<repository-ip>"
export SOURCE_VM_MAC="<source-mac>"
export REPO_VM_MAC="<repository-mac>"
export SOURCE_VM_IFACE="eth0"
export REPO_VM_IFACE="eth0"
export NG_REPO_PATH="<path-to-repository-on-guest>"
export NG_BUILD_PATH="<absolute-immutable-guest-build-path>"
export NG_SSH_KEY="$HOME/.ssh/id_ed25519"
export NG_SSH_USER="root"
export NG_EVIDENCE_PATH="<absolute-local-evidence-path>"
export NG_REMOTE_EVIDENCE_PATH="<absolute-persistent-guest-evidence-path>"
export NG_SSH_KNOWN_HOSTS="$HOME/.ssh/known_hosts.novagenesis"
# Required only for run plans with require_fresh_boot=true:
export NG_VM_HOST="<proxmox-host>"
export NG_VM_USER="<proxmox-user>"
export NG_VM_SSH_KEY="$HOME/.ssh/<proxmox-ssh-key>"
export NG_VM_KNOWN_HOSTS="$HOME/.ssh/known_hosts.proxmox"
export NG_REPO_VM_ID="101"
export NG_SOURCE_VM_ID="102"
