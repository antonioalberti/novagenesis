{
  "schema_version": 1,
  "scenario": "L5",
  "roles": [
    {
      "name": "PGCS-Source",
      "vm": "source",
      "command": ["${NG_BUILD_PATH}/PGCS", "${NG_REPO_PATH}/IO/PGCS/", "0", "Intra_Domain", "-p", "Ethernet", "Intra_Domain", "${SOURCE_VM_IFACE}", "${REPO_VM_MAC}", "1200"],
      "cwd": "${NG_BUILD_PATH}",
      "readiness": [
        {"id": "client-socket", "pattern": "Created the client socket with CSID"},
        {"id": "server-socket", "pattern": "Created the server socket with SSID"}
      ]
    },
    {
      "name": "PGCS-Repository",
      "vm": "repository",
      "command": ["${NG_BUILD_PATH}/PGCS", "${NG_REPO_PATH}/IO/PGCS/", "0", "Intra_Domain", "-p", "Ethernet", "Intra_Domain", "${REPO_VM_IFACE}", "${SOURCE_VM_MAC}", "1200"],
      "cwd": "${NG_BUILD_PATH}",
      "readiness": [
        {"id": "client-socket", "pattern": "Created the client socket with CSID"},
        {"id": "server-socket", "pattern": "Created the server socket with SSID"}
      ]
    },
    {
      "name": "NRNCS-Source",
      "vm": "source",
      "command": ["${NG_BUILD_PATH}/NRNCS", "${NG_REPO_PATH}/IO/NRNCS/"],
      "cwd": "${NG_BUILD_PATH}",
      "readiness": [
        {"id": "nrncs-operational", "pattern": "OPERATIONAL: Everything ok!"}
      ]
    },
    {
      "name": "Repository",
      "vm": "repository",
      "command": ["${NG_BUILD_PATH}/ContentApp", "${NG_REPO_PATH}/IO/Repository1/", "Repository"],
      "cwd": "${NG_BUILD_PATH}",
      "readiness": [
        {"id": "repository-operational", "pattern": "State: Operational"}
      ]
    },
    {
      "name": "Source",
      "vm": "source",
      "command": [
        "/usr/bin/python3",
        "-c",
        "import os,subprocess,sys; base=sys.argv[1]; build=sys.argv[2]; io=os.path.join(base,'IO','SourceStaging','ng-elc-${TRIAL_ID}'); os.makedirs(io,exist_ok=True); subprocess.run(['python3',os.path.join(base,'Scripts/Python/BuildPhotos.py'),'--staging',io,'different','5','100','100'],check=True); os.execv(os.path.join(build,'ContentApp'),[os.path.join(build,'ContentApp'),io,'Source'])",
        "${NG_REPO_PATH}",
        "${NG_BUILD_PATH}"
      ],
      "cwd": "${NG_BUILD_PATH}",
      "readiness": [
        {"id": "source-operational", "pattern": "State: Operational"}
      ]
    }
  ],
  "timeouts": {"readiness": 300, "observation": 120, "total": 600},
  "require_fresh_boot": true,
  "diagnostic_only": false,
  "debug_profile": "obs-normal",
  "runtime_oracle": {
    "type": "markers",
    "required": [
      {"role": "Source", "id": "publish-progress", "pattern": "Publishing the content"},
      {"role": "Repository", "id": "photo-received", "pattern": "ContentApp received payload: file="}
    ]
  }
}
